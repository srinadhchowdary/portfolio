# .cursorignore
# Ignore dependencies, build outputs, and large files to save AI tokens

# Node modules and package caches
node_modules/
.npm-cache/

# Build outputs
dist/
build/
out/
.next/
.nuxt/

# Lock files (These are often huge and the AI rarely needs to read every single locked version)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment variables
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage and test outputs
coverage/
.nyc_output/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Large media files or assets (Cursor usually ignores binaries, but good to be explicit for SVGs/large public folders)
public/
*.jpg
*.jpeg
*.png
*.gif
*.svg
*.ico
*.webp
*.mp4
*.webm
*.ogg
*.mp3
*.wav
*.flac
*.aac
*.pdf
